# Copy to .env and fill in
LLM_PROVIDER=local   # local | anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/index
CORPUS_PATH=./data/corpus

# Security / deployment
PAKISTANI_LAWYER_ENV=development   # production refuses the default dev API key
PAKISTANI_LAWYER_API_KEY=
TRUSTED_PROXY_COUNT=0              # number of reverse proxies in front of the API
QA_RATE_LIMIT_PER_MINUTE=30
SEARCH_RATE_LIMIT_PER_MINUTE=120
RETRIEVAL_MIN_SCORE=0.27
EMBEDDING_PROVIDER=hashing         # hashing | sentence-transformers

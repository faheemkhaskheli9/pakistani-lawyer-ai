# Copy to .env and fill in
# Required: shared API key for /api/v1/ask and /api/v1/search (no default).
PAKISTANI_LAWYER_API_KEY=
# Per-IP requests per minute across protected endpoints.
QA_RATE_LIMIT_PER_MINUTE=30
# Set to true only behind a trusted reverse proxy (honours X-Forwarded-For).
TRUST_PROXY=false
# "hashing" (default, offline) or "sentence-transformers".
EMBEDDING_PROVIDER=hashing
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.20

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "legal_core: ingest seed corpus",
            "type": "debugpy",
            "request": "launch",
            "module": "legal_core.ingest",
            "args": ["--corpus", "data/corpus"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": true
        },
        {
            "name": "legal_core: retrieve top-k",
            "type": "debugpy",
            "request": "launch",
            "module": "legal_core.retrieval",
            "args": ["admissibility of evidence", "--top-k", "3"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": true
        },
        {
            "name": "Python: Debug Tests (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests", "-v"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": true
        }
    ]
}
